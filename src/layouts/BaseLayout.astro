---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Presunto depredador',
  description = 'Serie audiovisual en video 360.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://use.typekit.net/fop2wxl.css" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
