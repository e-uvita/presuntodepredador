---
import { site } from "../config/site";
---

<div
  class="water-title"
  data-water-title
  data-logo={site.branding.title}
  style={`aspect-ratio: ${site.branding.titleWidth} / ${site.branding.titleHeight}`}
>
  <img
    src={site.branding.title}
    alt=""
    width={site.branding.titleWidth}
    height={site.branding.titleHeight}
  />
  <canvas aria-hidden="true"></canvas>
</div>
