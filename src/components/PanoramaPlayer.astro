---
import type { Chapter } from '../data/chapters';

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
---

<section
  class="player"
  data-panorama-player
  data-video={chapter.videoSrc}
  data-audio={chapter.audioSrc}
  data-subtitles={chapter.subtitlesSrc}
  data-audio-mode={chapter.audioMode}
  data-loop-video={String(chapter.loopVideo)}
>
  <div class="player__viewport">
    <canvas aria-label={`Video 360: ${chapter.title}`}></canvas>
    <p class="player__hint">Arrastra para mirar alrededor</p>
    <div class="player__subtitle" aria-live="polite" aria-atomic="true"></div>
  </div>

  <div class="player__controls">
    <button type="button" data-play>Reproducir</button>
    <input
      type="range"
      min="0"
      max="0"
      value="0"
      step="0.01"
      aria-label="Línea de tiempo"
      data-seek
    />
    <output data-time>00:00 / 00:00</output>
    <button type="button" data-mute>Silenciar</button>
  </div>

  <p class="player__status" data-status>Cargando medios…</p>
  <video crossorigin="anonymous" playsinline preload="metadata" hidden></video>
  <audio crossorigin="anonymous" preload="metadata" hidden></audio>
</section>

<script>
  import * as THREE from 'three';
  import { cueAtTime, parseSrt, type SubtitleCue } from '../lib/srt-parser';

  const formatTime = (seconds: number) => {
    if (!Number.isFinite(seconds)) return '00:00';
    const minutes = Math.floor(seconds / 60);
    const remainder = Math.floor(seconds % 60);
    return `${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-panorama-player]').forEach((root) => {
    const canvas = root.querySelector('canvas');
    const video = root.querySelector('video');
    const audio = root.querySelector('audio');
    const playButton = root.querySelector<HTMLButtonElement>('[data-play]');
    const muteButton = root.querySelector<HTMLButtonElement>('[data-mute]');
    const seek = root.querySelector<HTMLInputElement>('[data-seek]');
    const timeOutput = root.querySelector<HTMLOutputElement>('[data-time]');
    const subtitle = root.querySelector<HTMLElement>('.player__subtitle');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const viewport = root.querySelector<HTMLElement>('.player__viewport');

    if (!canvas || !video || !audio || !playButton || !muteButton || !seek || !timeOutput || !subtitle || !status || !viewport) return;

    // Alias no anulables: el componente controla este marcado y ya se validó arriba.
    const canvasElement = canvas;
    const videoElement = video;
    const audioElement = audio;
    const playControl = playButton;
    const muteControl = muteButton;
    const seekControl = seek;
    const timeControl = timeOutput;
    const subtitleElement = subtitle;
    const statusElement = status;
    const viewportElement = viewport;

    const audioMode = root.dataset.audioMode ?? 'integrated';
    const usesSeparateAudio = audioMode === 'separate' && Boolean(root.dataset.audio);
    const loopVideo = root.dataset.loopVideo === 'true';
    let cues: SubtitleCue[] = [];
    let dragging = false;
    let pointerX = 0;
    let pointerY = 0;
    let startLongitude = 0;
    let startLatitude = 0;
    let longitude = 0;
    let latitude = 0;

    videoElement.src = root.dataset.video ?? '';
    videoElement.muted = usesSeparateAudio;
    videoElement.loop = loopVideo;
    if (usesSeparateAudio) audioElement.src = root.dataset.audio ?? '';

    const renderer = new THREE.WebGLRenderer({ canvas: canvasElement, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, 1, 0.1, 100);
    const geometry = new THREE.SphereGeometry(5, 48, 32);
    geometry.scale(-1, 1, 1);
    const texture = new THREE.VideoTexture(videoElement);
    texture.colorSpace = THREE.SRGBColorSpace;
    const material = new THREE.MeshBasicMaterial({ map: texture });
    scene.add(new THREE.Mesh(geometry, material));

    const master = () => (usesSeparateAudio ? audioElement : videoElement);
    const duration = () => master().duration;
    const currentTime = () => master().currentTime;

    function resize() {
      const width = viewportElement.clientWidth;
      const height = viewportElement.clientHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      camera.updateProjectionMatrix();
    }

    function updateInterface() {
      const total = duration();
      const current = currentTime();
      if (Number.isFinite(total)) {
        seekControl.max = String(total);
        seekControl.value = String(current);
      }
      timeControl.value = `${formatTime(current)} / ${formatTime(total)}`;
      subtitleElement.textContent = cueAtTime(cues, current)?.text ?? '';
    }

    function seekAll(nextTime: number) {
      if (usesSeparateAudio) {
        audioElement.currentTime = nextTime;
        if (Number.isFinite(videoElement.duration) && videoElement.duration > 0) {
          videoElement.currentTime = loopVideo ? nextTime % videoElement.duration : Math.min(nextTime, videoElement.duration);
        }
      } else {
        videoElement.currentTime = nextTime;
      }
      updateInterface();
    }

    async function togglePlayback() {
      if (!master().paused) {
        videoElement.pause();
        audioElement.pause();
        playControl.textContent = 'Reproducir';
        return;
      }

      try {
        if (usesSeparateAudio) {
          if (Number.isFinite(videoElement.duration) && videoElement.duration > 0) {
            videoElement.currentTime = loopVideo ? audioElement.currentTime % videoElement.duration : audioElement.currentTime;
          }
          await Promise.all([videoElement.play(), audioElement.play()]);
        } else {
          await videoElement.play();
        }
        playControl.textContent = 'Pausar';
        statusElement.textContent = '';
      } catch {
        statusElement.textContent = 'El navegador no pudo reproducir alguno de los medios.';
      }
    }

    playControl.addEventListener('click', togglePlayback);
    muteControl.addEventListener('click', () => {
      const audibleMedia = usesSeparateAudio ? audioElement : videoElement;
      audibleMedia.muted = !audibleMedia.muted;
      muteControl.textContent = audibleMedia.muted ? 'Activar audio' : 'Silenciar';
    });
    seekControl.addEventListener('input', () => seekAll(Number(seekControl.value)));

    master().addEventListener('loadedmetadata', () => {
      statusElement.textContent = 'Listo para reproducir.';
      updateInterface();
    });
    master().addEventListener('ended', () => {
      videoElement.pause();
      audioElement.pause();
      playControl.textContent = 'Reproducir';
    });

    viewportElement.addEventListener('pointerdown', (event) => {
      dragging = true;
      pointerX = event.clientX;
      pointerY = event.clientY;
      startLongitude = longitude;
      startLatitude = latitude;
      viewportElement.setPointerCapture(event.pointerId);
    });
    viewportElement.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      longitude = (pointerX - event.clientX) * 0.12 + startLongitude;
      latitude = (event.clientY - pointerY) * 0.12 + startLatitude;
    });
    viewportElement.addEventListener('pointerup', () => (dragging = false));
    viewportElement.addEventListener('pointercancel', () => (dragging = false));

    async function loadSubtitles() {
      const source = root.dataset.subtitles;
      if (!source) return;
      try {
        const response = await fetch(source);
        if (!response.ok) throw new Error();
        cues = parseSrt(await response.text());
      } catch {
        statusElement.textContent = 'Los subtítulos no pudieron cargarse.';
      }
    }

    function animate() {
      latitude = Math.max(-85, Math.min(85, latitude));
      const phi = THREE.MathUtils.degToRad(90 - latitude);
      const theta = THREE.MathUtils.degToRad(longitude);
      camera.lookAt(
        0.5 * Math.sin(phi) * Math.cos(theta),
        0.5 * Math.cos(phi),
        0.5 * Math.sin(phi) * Math.sin(theta),
      );
      updateInterface();
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    new ResizeObserver(resize).observe(viewportElement);
    loadSubtitles();
    resize();
    animate();
  });
</script>
