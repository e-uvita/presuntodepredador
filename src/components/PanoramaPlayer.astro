---
import type { Chapter } from "../data/chapters";
import { chapterHref } from "../lib/paths";
import Icon from "./Icon.astro";
interface Props {
  chapter: Chapter;
  nextChapter?: Chapter;
  homeHref?: string;
}
const {
  chapter,
  nextChapter,
  homeHref = `${import.meta.env.BASE_URL}#episodios`,
} = Astro.props;
---

<section
  class="player"
  data-panorama-player
  data-projection={chapter.projection}
  data-has-audio={String(chapter.hasAudio)}
  data-audio={chapter.audioSrc}
  data-subtitles={chapter.subtitlesSrc}
  data-loop={String(Boolean(chapter.loopVideo))}
  tabindex="0"
  aria-label={`Reproductor: ${chapter.title}`}
>
  <video
    src={chapter.videoSrc}
    poster={chapter.posterSrc}
    playsinline
    webkit-playsinline
    preload="metadata"
    autoplay
    aria-label={`Video: ${chapter.title}`}></video>
  <canvas hidden aria-hidden="true"></canvas>
  <audio hidden preload="metadata"></audio>
  <div class="shade"></div>
  <a class="back round" href={homeHref} aria-label="Volver a los episodios"
    ><Icon name="back" /></a
  >
  <span class="badge"
    >{
      chapter.projection === "equirectangular"
        ? "360°"
        : "Video de demostración"
    }</span
  >
  <p class="hint" hidden>Arrastra o usa Mayús + flechas para mirar alrededor</p>
  <div class="subtitle"></div>
  <div class="notice" data-notice hidden>
    <p data-status role="status"></p>
    <button type="button" data-retry>Reintentar</button>
    {
      nextChapter && (
        <a href={chapterHref(nextChapter.slug)} data-next hidden>
          Siguiente episodio →
        </a>
      )
    }
  </div>
  <div class="controls" hidden>
    <div class="actions">
      <button class="round" type="button" data-play aria-label="Reproducir"
        ><span data-icon-play><Icon name="play" /></span><span
          data-icon-pause
          hidden><Icon name="pause" /></span
        ></button
      >
      <output data-time>00:00 / 00:00</output>
      <span class="spacer"></span>
      {
        chapter.subtitlesSrc && (
          <button
            class="round small"
            type="button"
            data-captions
            aria-label="Desactivar subtítulos"
            aria-pressed="true"
          >
            CC
          </button>
        )
      }
      <button
        class="round small"
        type="button"
        data-fullscreen
        aria-label="Pantalla completa"><Icon name="fullscreen" /></button
      >
      <button
        class="round"
        type="button"
        data-mute
        disabled={!chapter.hasAudio && !chapter.audioSrc}
        aria-label={chapter.hasAudio || chapter.audioSrc
          ? "Silenciar"
          : "Este video no tiene audio"}
        title={chapter.hasAudio || chapter.audioSrc
          ? "Silenciar"
          : "Este video no tiene audio"}
        ><span data-icon-sound><Icon name="sound" /></span><span
          data-icon-muted
          hidden><Icon name="muted" /></span
        ></button
      >
    </div>
    <input
      type="range"
      min="0"
      max="0"
      value="0"
      step="0.01"
      aria-label="Línea de tiempo"
      data-seek
    />
  </div>
</section>

<script>
  import { initPlayers } from "../lib/player";
  initPlayers();
</script>

<style>
  .player {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--player-background);
    color: var(--paper);
    isolation: isolate;
  }
  video,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .player[data-projection="equirectangular"] video {
    object-fit: cover;
  }
  video.canvas-video {
    opacity: 0;
  }
  canvas {
    touch-action: none;
    cursor: grab;
  }
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--player-shade);
  }
  .round {
    display: grid;
    place-items: center;
    flex: none;
    width: 4.25rem;
    height: 4.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    font: bold 1.4rem/1 var(--font-controls);
    text-decoration: none;
  }
  .round:focus-visible,
  input:focus-visible,
  .notice a:focus-visible {
    outline: 3px solid var(--caption);
    outline-offset: 4px;
  }
  .back {
    position: absolute;
    top: 1.8rem;
    left: 1.8rem;
  }
  .round :global(svg) {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
  }
  .small :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .round:disabled {
    opacity: 0.65;
    cursor: default;
  }
  .badge {
    position: absolute;
    top: 2.3rem;
    right: 1.8rem;
    color: var(--ink);
    font: 700 1.1rem/1 var(--font-body, Georgia, serif);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    padding: 0.45rem 0.65rem;
    border-radius: 2rem;
  }
  .hint {
    position: absolute;
    top: 5.5rem;
    right: 1.8rem;
    padding: 0.4rem 0.65rem;
    background: var(--overlay);
    font: 0.85rem var(--font-body, Georgia, serif);
  }
  .subtitle {
    position: absolute;
    bottom: 6rem;
    left: 12%;
    width: 76%;
    color: var(--caption);
    text-align: center;
    white-space: pre-line;
    text-shadow: var(--media-shadow);
    font: bold clamp(1rem, 1.5vw, 1.6rem)/1.2 var(--font-body, Georgia, serif);
    pointer-events: none;
  }
  .controls {
    position: absolute;
    bottom: 1.8rem;
    left: 1.8rem;
    right: 1.8rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }
  output {
    font: 0.85rem var(--font-controls);
    text-shadow: var(--media-shadow);
  }
  .spacer {
    flex: 1;
  }
  .small {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 0.95rem;
  }
  input[type="range"] {
    display: block;
    width: 100%;
    height: 1.5rem;
    margin: 0;
    border: 0;
    appearance: none;
    cursor: pointer;
    background: transparent;
  }
  input[type="range"]::-webkit-slider-runnable-track {
    height: 0.7rem;
    border-radius: 1rem;
    background: linear-gradient(
      to right,
      var(--progress) var(--progress, 0%),
      var(--paper) var(--progress, 0%)
    );
  }
  input[type="range"]::-moz-range-track {
    height: 0.7rem;
    border-radius: 1rem;
    background: linear-gradient(
      to right,
      var(--progress) var(--progress, 0%),
      var(--paper) var(--progress, 0%)
    );
  }
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: -0.25rem;
    border-radius: 50%;
    background: var(--progress);
  }
  input[type="range"]::-moz-range-thumb {
    width: 1.2rem;
    height: 1.2rem;
    border: 0;
    border-radius: 50%;
    background: var(--progress);
  }
  .notice {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    padding: 1.25rem;
    background: var(--overlay-strong);
    font: 1rem var(--font-body, Georgia, serif);
  }
  .notice button,
  .notice a {
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--paper);
    padding: 0.65rem 1rem;
    cursor: pointer;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 600px) {
    .back {
      top: 1rem;
      left: 1rem;
      font-size: 2.4rem;
    }
    .badge {
      top: 1rem;
      right: 1rem;
    }
    .round {
      width: 3.25rem;
      height: 3.25rem;
    }
    .controls {
      left: 1rem;
      right: 1rem;
      bottom: 1.2rem;
    }
    .actions {
      gap: 0.35rem;
      margin-bottom: 1rem;
    }
    .small {
      width: 2.75rem;
      height: 2.75rem;
    }
    .subtitle {
      bottom: 5.5rem;
      left: 5%;
      width: 90%;
    }
  }
</style>
