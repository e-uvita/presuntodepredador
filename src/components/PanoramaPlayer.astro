---
import type { Chapter } from "../data/chapters";
import { chapterHref } from "../lib/paths";
import Icon from "./Icon.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
interface Props {
  chapter: Chapter;
  previousChapter?: Chapter;
  nextChapter?: Chapter;
  homeHref?: string;
}
const {
  chapter,
  previousChapter,
  nextChapter,
  homeHref = `${import.meta.env.BASE_URL}#episodios`,
} = Astro.props;
const markSvg = readFileSync(
  resolve(process.cwd(), "public/branding/mark.svg"),
  "utf8",
).replace(/^<\?xml[^>]*\?>\s*/, "");
---

<section
  class="player"
  data-panorama-player
  data-projection={chapter.projection}
  data-has-audio={String(chapter.hasAudio)}
  data-audio={chapter.audioSrc}
  data-subtitles={chapter.subtitlesSrc}
  data-loop={String(Boolean(chapter.loopVideo))}
  data-next-href={nextChapter ? chapterHref(nextChapter.slug) : undefined}
  tabindex="0"
  aria-label={`Reproductor: ${chapter.title}`}
>
  <video
    src={chapter.videoSrc}
    poster={chapter.posterSrc}
    playsinline
    webkit-playsinline
    preload="metadata"
    autoplay
    aria-label={`Video: ${chapter.title}`}></video>
  <canvas hidden aria-hidden="true"></canvas>
  <audio hidden preload="metadata"></audio>
  <div class="shade"></div>
  <a class="back" href={homeHref} aria-label="Volver a los episodios">
    <span class="back__mark" aria-hidden="true" set:html={markSvg}></span>
    <span class="back__label">Volver</span>
  </a>
  <span class="badge"
    >{
      chapter.projection === "equirectangular"
        ? "360°"
        : "Video de demostración"
    }</span
  >
  <p class="hint" data-mode="intro" hidden>Arrastra para mirar alrededor</p>
  <section class="paused-info" data-paused-info hidden aria-hidden="true">
    <div class="paused-info__copy">
      <p class="paused-info__eyebrow">Estás viendo · Episodio {chapter.number}</p>
      <div class="paused-info__title" data-water-title data-text={chapter.title}>
        <h2 data-water-source>{chapter.title}</h2>
        <canvas aria-hidden="true"></canvas>
      </div>
      <p class="paused-info__meta">
        {chapter.durationLabel}
      </p>
      <p class="paused-info__summary" set:html={chapter.summary}></p>
    </div>
    <p class="paused-info__status">En pausa</p>
  </section>
  <div class="subtitle"></div>
  <div class="notice" data-notice hidden>
    <p data-status role="status"></p>
    <button type="button" data-retry>Reintentar</button>
  </div>
  <div class="controls" hidden>
    <input
      type="range"
      min="0"
      max="0"
      value="0"
      step="0.01"
      aria-label="Línea de tiempo"
      data-seek
    />
    <div class="actions">
      <div class="actions__left">
        <button class="round" type="button" data-play aria-label="Reproducir"
          ><span data-icon-play><Icon name="play" /></span><span
            data-icon-pause
            hidden><Icon name="pause" /></span
          ></button
        >
        <output data-time>00:00 / 00:00</output>
      </div>
      <div class="episode-bar" role="group" aria-label="Episodio actual y navegación">
        <div class="episode-bar__side episode-bar__side--previous">
          {
            previousChapter && (
              <a
                class="episode-switch episode-switch--previous"
                href={chapterHref(previousChapter.slug)}
                aria-label={`Episodio anterior: ${previousChapter.title}`}
                title={`Episodio anterior: ${previousChapter.title}`}
              >
                <Icon name="back" />
              </a>
            )
          }
        </div>
        <p class="episode-bar__title" title={chapter.title}>{chapter.title}</p>
        <div class="episode-bar__side episode-bar__side--next">
          {
            nextChapter && (
              <a
                class="episode-switch episode-switch--next"
                href={chapterHref(nextChapter.slug)}
                aria-label={`Siguiente episodio: ${nextChapter.title}`}
                title={`Siguiente episodio: ${nextChapter.title}`}
              >
                <Icon name="arrow" />
              </a>
            )
          }
        </div>
      </div>
      <div class="actions__right">
        {
          chapter.subtitlesSrc && (
            <button
              class="round small"
              type="button"
              data-captions
              aria-label="Desactivar subtítulos"
              aria-pressed="true"
            >
              CC
            </button>
          )
        }
        <button
          class="round small"
          type="button"
          data-fullscreen
          aria-label="Pantalla completa"
          title="Pantalla completa"
        >
          <span data-icon-fullscreen><Icon name="fullscreen" /></span>
          <span data-icon-fullscreen-exit hidden>
            <Icon name="fullscreenExit" />
          </span>
        </button
        >
        <button
          class="round"
          type="button"
          data-mute
          disabled={!chapter.hasAudio && !chapter.audioSrc}
          aria-label={chapter.hasAudio || chapter.audioSrc
            ? "Silenciar"
            : "Este video no tiene audio"}
          title={chapter.hasAudio || chapter.audioSrc
            ? "Silenciar"
            : "Este video no tiene audio"}
          ><span data-icon-sound><Icon name="sound" /></span><span
            data-icon-muted
            hidden><Icon name="muted" /></span
          ></button
        >
      </div>
    </div>
  </div>
</section>

<script>
  import { initPlayers } from "../lib/player";
  initPlayers();
</script>

<style>
  .player {
    /* Safe-area del reproductor: volver, etiqueta, pausa y controles comparten borde. */
    --player-safe: 1.8rem;
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--player-background);
    color: var(--paper);
    isolation: isolate;
  }
  video,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .player[data-projection="equirectangular"] video {
    object-fit: cover;
  }
  video.canvas-video {
    opacity: 0;
  }
  canvas {
    touch-action: none;
    cursor: grab;
  }
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--player-shade);
  }
  .paused-info {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 8rem var(--player-safe);
    background: linear-gradient(
      90deg,
      rgb(20 25 48 / 78%) 0%,
      rgb(20 25 48 / 54%) 62%,
      rgb(20 25 48 / 12%) 100%
    );
    pointer-events: none;
  }
  .paused-info__copy {
    width: min(100%, 58rem);
  }
  .paused-info__eyebrow {
    margin: 0 0 0.9rem;
    font: 600 clamp(1rem, 1vw, 1rem)/1.2 var(--font-body, Georgia, serif);
  }
  .paused-info__title {
    position: relative;
    width: min(100%, 54rem);
    margin-bottom: 1.25rem;
  }
  .paused-info__title h2 {
    margin: 0;
    color: var(--paper);
    font: 700 clamp(3rem, 8vw, 8rem)/0.9 var(--font-display);
    overflow-wrap: anywhere;
    transition: opacity 0.2s;
  }
  .paused-info__title canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .paused-info__title[data-ready] h2 {
    opacity: 0;
  }
  .paused-info__title[data-ready] canvas {
    opacity: 1;
  }
  .paused-info__summary {
    max-width: 55ch;
    margin: 0;
    font: 400 clamp(1rem, 1vw, 1rem)/1.5 var(--font-body, Georgia, serif);

  }
  .paused-info__meta {
    margin: -0.5rem 0 0.8rem;
    font: 600 0.95rem/1.3 var(--font-body, Georgia, serif);
  }
  .paused-info__status {
    position: absolute;
    right: var(--player-safe);
    bottom: clamp(1rem, 2vw, 2rem);
    margin: 0;
    font: 500 1rem/1.2 var(--font-body, Georgia, serif);
  }
  .round {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    font: bold var(--text-emphasis)/1 var(--font-controls);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .round:not(:disabled):hover {
    background: var(--progress);
    color: var(--paper);
  }
  .round:focus-visible,
  input:focus-visible,
  .notice a:focus-visible {
    outline: 3px solid var(--caption);
    outline-offset: 4px;
  }
  .back {
    position: absolute;
    z-index: 3;
    top: var(--player-safe);
    left: var(--player-safe);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--paper);
    text-decoration: none;
  }
  .back__mark {
    display: block;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
  }
  .back__mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .back:hover .back__mark :global(.cls-1) {
    fill: var(--progress);
  }
  .back:hover .back__mark :global(.cls-2) {
    fill: var(--paper);
  }
  .back__label {
    font: 400 var(--text-xs)/1 var(--font-body, Georgia, serif);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: var(--media-shadow);
  }
  .back:focus-visible {
    outline: 3px solid var(--caption);
    outline-offset: 4px;
    border-radius: 2rem;
  }
  .round :global(svg) {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
  }
  .small :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .round:disabled {
    opacity: 0.65;
    cursor: default;
  }
  .badge {
    position: absolute;
    z-index: 3;
    /* Centrada verticalmente con el símbolo de volver (2.75rem). */
    top: calc(var(--player-safe) + 0.5rem);
    right: var(--player-safe);
    color: var(--ink);
    font: 700 var(--text-player-badge)/1 var(--font-body, Georgia, serif);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    padding: 0.45rem 0.65rem;
    border-radius: 2rem;
  }
  /* Instrucción de arrastre: primero destacada al centro, luego discreta arriba. */
  .hint {
    position: absolute;
    z-index: 3;
    left: 50%;
    width: max-content;
    max-width: calc(100% - 2rem);
    margin: 0;
    color: var(--paper);
    text-align: center;
    pointer-events: none;
    transition: opacity 0.7s ease;
  }
  .hint[data-mode="intro"] {
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0.9rem 1.4rem;
    border-radius: var(--radius-image);
    background: var(--overlay);
    font: 600 var(--text-xl)/1.3 var(--font-body, Georgia, serif);
  }
  .hint[data-mode="compact"] {
    top: calc(var(--player-safe) + 0.5rem);
    transform: translateX(-50%);
    padding: 0.45rem 0.8rem;
    border-radius: 2rem;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    font: 400 var(--text-xs)/1 var(--font-body, Georgia, serif);
    letter-spacing: 0.06em;
    opacity: 0.8;
  }
  .hint[data-fading="true"] {
    opacity: 0;
  }
  .subtitle {
    position: absolute;
    z-index: 3;
    bottom: 6rem;
    left: 12%;
    width: 76%;
    color: var(--caption);
    text-align: center;
    white-space: pre-line;
    text-shadow: var(--media-shadow);
    font: bold var(--text-player-subtitle)/1.2 var(--font-body, Georgia, serif);
    pointer-events: none;
  }
  .controls {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    bottom: var(--player-safe);
    left: var(--player-safe);
    right: var(--player-safe);
  }
  .back,
  .badge,
  .hint,
  .controls {
    transition: opacity 0.2s ease;
  }
  .player[data-controls-hidden="true"] .back,
  .player[data-controls-hidden="true"] .badge,
  .player[data-controls-hidden="true"] .hint[data-mode="compact"],
  .player[data-controls-hidden="true"] .controls {
    opacity: 0;
    pointer-events: none;
  }
  .actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    margin-top: 1rem;
  }
  .actions__left,
  .actions__right {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
  }
  .actions__right {
    justify-content: flex-end;
  }
  output {
    font: var(--text-xl) var(--font-body, Georgia, serif);
    text-shadow: var(--media-shadow);
    white-space: nowrap;
  }
  .small {
    width: 2.75rem;
    height: 2.75rem;
    font-size: var(--text-player-small-control);
  }
  input[type="range"] {
    --seek-track-height: 0.25rem;
    --seek-thumb-scale: 1;
    display: block;
    width: 100%;
    height: 1.5rem;
    margin: 0;
    border: 0;
    appearance: none;
    cursor: pointer;
    background: transparent;
  }
  .episode-bar {
    display: grid;
    min-width: 0;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.65rem;
  }
  .episode-bar__side {
    display: flex;
    min-width: 0;
    align-items: center;
  }
  .episode-bar__side--previous {
    justify-content: flex-end;
  }
  .episode-bar__side--next {
    justify-content: flex-start;
  }
  .episode-bar__title {
    grid-column: 2;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--paper);
    font: 600 clamp(1.5rem, 1.1vw, 1.1rem)/1.2 var(--font-display);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .episode-switch {
    display: inline-flex;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 18%, transparent);
    color: var(--paper);
    font: 600 0.85rem/1 var(--font-body, Georgia, serif);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .episode-switch:hover {
    background: var(--progress);
    color: var(--paper);
  }
  .episode-switch :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  input[type="range"]:hover,
  input[type="range"]:active,
  input[type="range"]:focus-visible {
    --seek-track-height: 0.55rem;
    --seek-thumb-scale: 1.35;
  }
  input[type="range"]::-webkit-slider-runnable-track {
    height: var(--seek-track-height);
    border-radius: 1rem;
    transition: height 0.15s ease;
    background: linear-gradient(
      to right,
      var(--ocean-deep) var(--seek-progress, 0%),
      color-mix(in srgb, var(--paper) 38%, transparent) var(--seek-progress, 0%)
    );
  }
  input[type="range"]::-moz-range-track {
    height: var(--seek-track-height);
    border-radius: 1rem;
    transition: height 0.15s ease;
    background: linear-gradient(
      to right,
      var(--ocean-deep) var(--seek-progress, 0%),
      color-mix(in srgb, var(--paper) 38%, transparent) var(--seek-progress, 0%)
    );
  }
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: -0.225rem;
    border-radius: 50%;
    background: var(--ocean-deep);
    transition: transform 0.15s ease;
    transform: scale(var(--seek-thumb-scale));
  }
  input[type="range"]::-moz-range-thumb {
    width: 0.7rem;
    height: 0.7rem;
    border: 0;
    border-radius: 50%;
    background: var(--ocean-deep);
    transition: transform 0.15s ease;
    transform: scale(var(--seek-thumb-scale));
  }
  .notice {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    padding: 1.25rem;
    background: var(--overlay-strong);
    font: var(--text-base) var(--font-body, Georgia, serif);
  }
  .notice button,
  .notice a {
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--paper);
    padding: 0.65rem 1rem;
    cursor: pointer;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 600px) {
    .player {
      --player-safe: 1rem;
    }
    .paused-info {
      align-items: flex-end;
      padding: 1.25rem var(--player-safe) 7.5rem;
      background: linear-gradient(
        0deg,
        rgb(20 25 48 / 92%) 0%,
        rgb(20 25 48 / 68%) 58%,
        rgb(20 25 48 / 10%) 100%
      );
    }
    .paused-info__title h2 {
      font-size: clamp(3rem, 15vw, 5rem);
    }
    .paused-info__summary {
      font-size: 1rem;
    }
    .back {
      gap: 0.55rem;
    }
    .back__label {
      font-size: var(--text-2xs);
    }
    .hint[data-mode="compact"] {
      /* Debajo de la fila superior para no chocar con «Volver» y la etiqueta. */
      top: calc(var(--player-safe) + 3.4rem);
      font-size: var(--text-2xs);
    }
    .hint[data-mode="intro"] {
      font-size: var(--text-md);
    }
    .round {
      width: 2.75rem;
      height: 2.75rem;
    }
    .controls {
      bottom: 1.2rem;
    }
    .actions {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.3rem;
      margin-top: 0.75rem;
    }
    .actions__left,
    .actions__right {
      gap: 0.25rem;
    }
    .actions__left output {
      font-size: 0.72rem;
    }
    .episode-bar {
      gap: 0.15rem;
    }
    .episode-bar__title {
      font-size: 0.8rem;
    }
    .small {
      width: 2.75rem;
      height: 2.75rem;
    }
    .subtitle {
      bottom: 5.5rem;
      left: 5%;
      width: 90%;
    }
  }
</style>
