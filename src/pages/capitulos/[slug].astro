---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PanoramaPlayer from "../../components/PanoramaPlayer.astro";
import { chapters, type Chapter } from "../../data/chapters";
import { asset, chapterHref } from "../../lib/paths";
import { site } from "../../config/site";
export function getStaticPaths() {
  return chapters.map((chapter) => ({
    params: { slug: chapter.slug },
    props: { chapter },
  }));
}
interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
const index = chapters.findIndex((item) => item.slug === chapter.slug);
const next = chapters[index + 1];
---

<BaseLayout
  title={`${chapter.title} — ${site.name}`}
  description={chapter.summary}
>
  <main id="contenido" class="chapter-detail">
    <h1 class="sr-only">Episodio {chapter.number}: {chapter.title}</h1>
    <PanoramaPlayer
      chapter={chapter}
      nextChapter={next}
      homeHref={`${asset("")}#episodios`}
    />
    <section class="episode-info content-width" aria-labelledby="episode-title">
      <p class="eyebrow">
        Episodio {chapter.number}{
          chapter.isPreview ? " · Video de muestra" : ""
        }
      </p>
      <h2 id="episode-title">{chapter.title}</h2>
      <p>{chapter.summary}</p>
      <nav class="chapter-nav" aria-label="Navegación entre episodios">
        <a href={`${asset("")}#episodios`}>← Todos los episodios</a>
        {next && <a href={chapterHref(next.slug)}>Siguiente: {next.title} →</a>}
      </nav>
    </section>
  </main>
</BaseLayout>
