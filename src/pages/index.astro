---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaterTitle from "../components/WaterTitle.astro";
import ChapterCard from "../components/ChapterCard.astro";
import Icon from "../components/Icon.astro";
import SiteNav from "../components/SiteNav.astro";
import { site } from "../config/site";
import { chapters } from "../data/chapters";
import { introduction, synopsis, credits } from "../data/story";
import { chapterHref } from "../lib/paths";
const firstChapter = chapters[0];
const hasPreviews = chapters.some((chapter) => chapter.isPreview);
---

<BaseLayout>
  <main id="contenido">
    <header class="hero" data-hero>
      <img
        class="hero__poster"
        src={site.heroImage}
        alt={site.heroImageAlt}
        width="1600"
        height="1200"
        fetchpriority="high"
      />
      <div class="hero__shade"></div>
      <SiteNav active="series" />
      <div class="hero__title">
        <h1 class="sr-only">{site.name}</h1>
        <WaterTitle />
        <p class="hero__tagline" set:html={introduction}></p>
      </div>
      <div class="hero__bottom">
        <div class="hero__actions">
          {
            firstChapter && (
              <a class="watch-button" href={chapterHref(firstChapter.slug)}>
                Explora las profundidades<Icon name="play" />
              </a>
            )
          }
          <a
            class="watch-button watch-button--secondary"
            href="#sinopsis"
            aria-label="Leer sinopsis"
          >
            Sinopsis <Icon name="plus" />
          </a>
        </div>
      </div>
    </header>

    <div class="ocean-content">
      <div class="content-width">
        <section
          class="synopsis"
          id="sinopsis"
          aria-labelledby="synopsis-title"
        >
          <p class="eyebrow">{site.year} · {chapters.length} episodios</p>
          <h2 id="synopsis-title" set:html={site.tagline} />
          <div class="synopsis__text">
            {synopsis.map((paragraph) => <p set:html={paragraph} />)}
          </div>
        </section>
        <section
          class="chapters"
          id="episodios"
          aria-labelledby="chapters-title"
        >
          <div class="section-heading">
            <h2 id="chapters-title">Episodios</h2><span
              >{String(chapters.length).padStart(2, "0")} episodios</span
            >
          </div>
          <ol class="chapters__list">
            {chapters.map((chapter) => <ChapterCard chapter={chapter} />)}
          </ol>
          {
            // hasPreviews && (
            //   <p class="preview-note">
            //     Algunos episodios incluyen por ahora un video de muestra.
            //   </p>
            // )
          }
        </section>
        <details class="credits">
          <summary>Créditos <span aria-hidden="true">+</span></summary>
          <dl>
            {
              credits.map(([role, name]) => (
                <div>
                  <>
                    <dt set:html={role} />
                    <dd>{name}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </details>
        <footer class="footer">
          <span>{site.name}</span><span>{site.year}</span><a
            href="#contenido"
            aria-label="Volver al inicio">Volver a la superficie ↑</a
          >
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { initHero } from "../lib/hero";
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) initHero(hero);
</script>
